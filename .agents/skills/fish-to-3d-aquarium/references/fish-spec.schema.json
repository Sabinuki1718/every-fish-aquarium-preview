{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fish-spec.schema.json",
  "title": "fish-spec（ブラウザ簡易版の3Dモデルの設計図）",
  "description": "座標はすべて全長 TL=1 の単位。x=0 が吻端、x=1 が尾鰭後端。y は上が正、y=0 は吻端の高さ。側面図は頭が左。説明は browser-fallback-spec.md。",
  "type": "object",
  "required": [
    "id",
    "name_ja",
    "scientific_name",
    "length_cm",
    "source",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name_ja": {
      "type": "string"
    },
    "scientific_name": {
      "type": "string"
    },
    "variant": {
      "type": [
        "string",
        "null"
      ],
      "description": "雌雄・婚姻色・成長段階・地域個体群など"
    },
    "length_cm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "全長(cm)。水槽内の大きさに使う"
    },
    "source": {
      "enum": [
        "procedural",
        "three_view"
      ],
      "description": "procedural=資料から数値化 / three_view=承認済みの三面図から読んだ"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "body": {
      "type": "object",
      "required": [
        "top",
        "bottom",
        "half_width"
      ],
      "properties": {
        "end_x": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1,
          "description": "胴体（尾柄）の後端。ここから後ろは尾鰭"
        },
        "top": {
          "$ref": "#/definitions/curve",
          "description": "側面図の背側輪郭 [[x, y], ...]（鰭を除く）"
        },
        "bottom": {
          "$ref": "#/definitions/curve",
          "description": "側面図の腹側輪郭 [[x, y], ...]（鰭を除く）"
        },
        "half_width": {
          "$ref": "#/definitions/curve",
          "description": "背面図の半幅 [[x, w], ...]（胸鰭を除く）"
        },
        "section_exponent": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/curve"
            }
          ],
          "description": "断面の超楕円の指数。2=楕円、大きいほど角ばる（ハコフグなど）、1.5前後で菱形寄り"
        }
      }
    },
    "fins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "outline"
        ],
        "properties": {
          "type": {
            "enum": [
              "dorsal",
              "dorsal1",
              "dorsal2",
              "dorsal3",
              "adipose",
              "anal",
              "anal1",
              "anal2",
              "caudal",
              "finlets",
              "pectoral",
              "pelvic"
            ]
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/definitions/point"
            },
            "description": "側面図上の輪郭（対鰭は体側にたたんだ状態の見え方）"
          },
          "paired": {
            "type": "boolean"
          },
          "base": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/definitions/point"
            },
            "description": "対鰭の付け根の線（2点）"
          },
          "spread_deg": {
            "type": "number",
            "description": "対鰭を体から開く角度"
          },
          "flap": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "edge_color": {
            "type": "string"
          },
          "edge_width": {
            "type": "number"
          },
          "rays": {
            "type": "integer"
          },
          "ray_color": {
            "type": "string"
          },
          "markings": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/marking"
            }
          }
        }
      }
    },
    "eye": {
      "type": "object",
      "required": [
        "x",
        "y",
        "r"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "r": {
          "type": "number"
        },
        "iris": {
          "type": "string"
        },
        "pupil": {
          "type": "string"
        },
        "pupil_ratio": {
          "type": "number"
        },
        "inset": {
          "type": "number"
        }
      }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "texture_bounds": {
          "type": "object",
          "required": [
            "x0",
            "x1",
            "y0",
            "y1"
          ],
          "properties": {
            "x0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            }
          },
          "description": "ビューアにドロップする側面図の画像が覆う範囲（頭が左）"
        },
        "base_colors": {
          "type": "object",
          "properties": {
            "dorsal": {
              "type": "string"
            },
            "flank": {
              "type": "string"
            },
            "ventral": {
              "type": "string"
            }
          }
        },
        "ventral_start": {
          "type": "number"
        },
        "fin_color": {
          "type": "string"
        },
        "fin_opacity": {
          "type": "number"
        },
        "markings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/marking"
          }
        },
        "roughness": {
          "type": "number"
        },
        "metalness": {
          "type": "number"
        },
        "clearcoat": {
          "type": "number"
        },
        "iridescence": {
          "type": "number"
        }
      }
    },
    "swim": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "anguilliform",
            "subcarangiform",
            "carangiform",
            "thunniform",
            "ostraciiform",
            "labriform",
            "balistiform",
            "benthic",
            "hovering",
            "drifting"
          ]
        },
        "amplitude": {
          "type": "number"
        },
        "frequency": {
          "type": "number"
        },
        "waves": {
          "type": "number"
        },
        "fin_flap": {
          "type": "number"
        }
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "このモデルで再現した同定形質（traits.md と対応）"
    },
    "notes": {
      "type": "string"
    },
    "barbels": {
      "type": "array",
      "description": "ひげ。左右対で作る",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "length"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "length": {
            "type": "number"
          },
          "angle_deg": {
            "type": "number",
            "description": "側面図上の向き。前0°・下90°"
          },
          "spread_deg": {
            "type": "number",
            "description": "外側への開き"
          },
          "thickness": {
            "type": "number"
          },
          "color": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "curve": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/point"
      }
    },
    "marking": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "band",
            "stripe",
            "lateral_line",
            "spots",
            "blotch",
            "ocellus",
            "patch",
            "reticulate"
          ]
        },
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "blur": {
          "type": "number"
        }
      }
    }
  }
}
